---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../config/site.config';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<BaseLayout title={SITE.blog.title} description={SITE.blog.description}>
  <div class="page">
    <h1>{SITE.blog.title}</h1>
    {posts.length === 0 && <p class="lead">Pronto publicaremos artículos aquí.</p>}
    <ul class="post-list">
      {posts.map((post) => (
        <li>
          <a href={`/blog/${post.id}`}>
            <h2>{post.data.title}</h2>
          </a>
          <p>{post.data.description}</p>
          <time datetime={post.data.pubDate.toISOString()}>
            {post.data.pubDate.toLocaleDateString(SITE.lang, { year: 'numeric', month: 'long', day: 'numeric' })}
          </time>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
<style>
  .post-list { list-style: none; display: grid; gap: 2rem; max-width: 44rem; }
  .post-list a { text-decoration: none; color: inherit; }
  .post-list h2 { margin: 0 0 0.25rem; font-size: 1.6rem; }
  .post-list time { color: var(--ink-2); font-size: 0.9rem; }
</style>
