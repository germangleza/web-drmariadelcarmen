---
import BaseLayout from '../layouts/BaseLayout.astro';
import FAQSchema from '../components/schema/FAQSchema.astro';
import { SITE } from '../config/site.config';

// FAQs de pacientes: edítalas por proyecto. Rankean en Google y alimentan a los LLMs (GEO).
const faqs = [
  { question: '¿Aceptan pacientes nuevos?', answer: SITE.business.acceptingNewPatients ? 'Sí, aceptamos pacientes nuevos. Agenda tu cita por teléfono o correo.' : 'Por el momento no aceptamos pacientes nuevos.' },
  { question: '¿Dónde están ubicados?', answer: `Estamos en ${SITE.business.address.street}, ${SITE.business.address.city}.` },
  { question: '¿Cuáles son sus horarios?', answer: 'Lunes a viernes de 9:00 a 19:00 y sábados de 9:00 a 14:00.' },
];
---
<BaseLayout>
  <FAQSchema faqs={faqs} />

  <section class="hero">
    <h1>{SITE.name}</h1>
    <p>{SITE.description}</p>
    <p><a class="cta" href={`tel:${SITE.business.phone.replace(/\s/g, '')}`}>Agendar cita: {SITE.business.phone}</a></p>
  </section>

  <section aria-labelledby="ubicacion-title">
    <h2 id="ubicacion-title">Ubicación y horarios</h2>
    <address>
      {SITE.business.address.street}<br />
      {SITE.business.address.city}, {SITE.business.address.state} {SITE.business.address.zip}
    </address>
    <ul>
      {SITE.business.openingHours.map((h) => <li>{h.replace('Mo-Fr', 'Lun-Vie').replace('Sa', 'Sáb')}</li>)}
    </ul>
  </section>

  <section id="faq" aria-labelledby="faq-title">
    <h2 id="faq-title">Preguntas frecuentes</h2>
    {faqs.map((f) => (
      <details>
        <summary>{f.question}</summary>
        <p>{f.answer}</p>
      </details>
    ))}
  </section>

  <section id="contacto" aria-labelledby="contacto-title">
    <h2 id="contacto-title">Contacto</h2>
    <p>
      <a href={`mailto:${SITE.business.email}`}>{SITE.business.email}</a> ·
      <a href={`tel:${SITE.business.phone.replace(/\s/g, '')}`}>{SITE.business.phone}</a>
    </p>
  </section>
</BaseLayout>
<style>
  .cta {
    display: inline-block; background: #0e7490; color: #fff;
    padding: 0.7rem 1.4rem; border-radius: 8px; text-decoration: none; font-weight: 600;
  }
</style>
