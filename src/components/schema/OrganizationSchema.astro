---
/**
 * JSON-LD de entidad médica (MedicalClinic / Physician / Dentist / MedicalOrganization).
 * Incluye especialidades, geo, horarios y equipo médico. Se incluye una vez por sitio.
 */
import { SITE, socialUrls } from '../../config/site.config';

const b = SITE.business;

const schema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': b.type,
  name: SITE.name,
  legalName: b.legalName,
  url: SITE.url,
  logo: new URL(SITE.logo, SITE.url).href,
  image: new URL(SITE.ogImage, SITE.url).href,
  email: b.email,
  telephone: b.phone,
  priceRange: b.priceRange,
  medicalSpecialty: b.specialties,
  isAcceptingNewPatients: b.acceptingNewPatients,
  sameAs: socialUrls(),
  address: {
    '@type': 'PostalAddress',
    streetAddress: b.address.street,
    addressLocality: b.address.city,
    addressRegion: b.address.state,
    postalCode: b.address.zip,
    addressCountry: b.address.country,
  },
};

if (b.geo.lat) {
  schema.geo = { '@type': 'GeoCoordinates', latitude: b.geo.lat, longitude: b.geo.lng };
}
if (b.openingHours.length) schema.openingHours = b.openingHours;

// Equipo médico como empleados (refuerza E-E-A-T a nivel entidad)
if (SITE.medicalTeam.length) {
  schema.employee = SITE.medicalTeam.map((m) => ({
    '@type': 'Physician',
    name: m.name,
    jobTitle: m.title,
    image: new URL(m.photo, SITE.url).href,
    sameAs: m.sameAs,
  }));
}
---
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
